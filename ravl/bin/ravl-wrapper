#!/usr/bin/env bash
# RAVL Framework Wrapper
# This script ensures the ravl.py entry point is called with the correct Python interpreter

# Resolve the actual location of this script (following symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
  SOURCE="$( readlink "$SOURCE" )"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"

# Find framework root (.ravl directory)
# ravl-wrapper is at .ravl/ravl/bin/ravl-wrapper
# SCRIPT_DIR is .ravl/ravl/bin, so go up 2 levels to get .ravl
FRAMEWORK_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Check if venv exists and use its Python, otherwise fall back to system python3
VENV_PYTHON="$FRAMEWORK_ROOT/venv/bin/python"
if [ -x "$VENV_PYTHON" ]; then
  exec "$VENV_PYTHON" "${SCRIPT_DIR}/ravl.py" "$@"
else
  # Fallback to system python3 if venv doesn't exist
  exec python3 "${SCRIPT_DIR}/ravl.py" "$@"
fi
