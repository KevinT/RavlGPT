# RAVL Framework Environment Variables
# Copy this file to .env and fill in your actual values

# ==============================================================================
# LLM Provider API Keys
# ==============================================================================
# At least one provider must be configured for LLM-driven code generation

# Anthropic Claude (recommended, high quality)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI GPT (alternative)
# OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (alternative)
# GOOGLE_API_KEY=your-google-api-key-here

# Ollama (local LLM option)
# OLLAMA_HOST=http://localhost:11434

# ==============================================================================
# LLM Defaults (Token Optimization & Limits)
# ==============================================================================
# Configure via wizard: ravl --config → 3) LLM Defaults
# Or set environment variables manually below to override framework defaults

# Prompt Normalization Settings (reduces token usage by 40-70%)
# RAVL_PROMPT_NORMALIZATION_ENABLED=true
# RAVL_PROMPT_NORMALIZATION_MIN_BLOCK_SIZE=200
# RAVL_PROMPT_NORMALIZATION_ENABLE_LOGGING=true

# Max Tokens Per Use Case (higher = more detailed, but more expensive)
# RAVL_MAX_TOKENS_CODE_GENERATION=16384
# RAVL_MAX_TOKENS_ACT_PHASE_CODE_GENERATION=16384
# RAVL_MAX_TOKENS_DATA_INGRESS_CODE_GENERATION=8192
# RAVL_MAX_TOKENS_DOMAIN_CONTEXT_SYNTHESIS=4096
# RAVL_MAX_TOKENS_VERIFICATION=4096
# RAVL_MAX_TOKENS_LEARN_INSIGHTS=4096
# RAVL_MAX_TOKENS_MARKDOWN_ENHANCEMENT=4096
# RAVL_MAX_TOKENS_HEALTH_CHECK_EXECUTION_ANALYSIS=4096
# RAVL_MAX_TOKENS_HEALTH_CHECK_DOMAIN_ANALYSIS=4096
# RAVL_MAX_TOKENS_DEFAULT=8192

# NOTE: If not set, framework defaults from ravl/config/ravl.toml are used

# ==============================================================================
# Virtual Environment Configuration
# ==============================================================================
# Configure default location for loop virtual environments

# Default directory for all venvs (optional)
# Defaults to .ravl/venv if not specified
# RAVL_DEFAULT_VENV_DIRECTORY=/data/venvs/ravl

# ==============================================================================
# Google Workspace API Credentials
# ==============================================================================
# Required for loops that access Google Docs, Sheets, Drive, etc.
# See project documentation for OAuth setup instructions

# GOOGLE_CREDENTIALS='{"type":"authorized_user","client_id":"...","client_secret":"...","refresh_token":"..."}'

# ==============================================================================
# Other Integrations
# ==============================================================================
# Add API keys for other services as needed by your loops

# HiBob HR Integration (example)
# HIBOB_SERVICE_USER_ID=user@company.com
# HIBOB_API_TOKEN=your-api-token

# ClickUp Project Management (example)
# CLICKUP_API_TOKEN=your-clickup-token
